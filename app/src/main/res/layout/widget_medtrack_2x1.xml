<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <ImageView
        android:id="@+id/widget_mascot"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginEnd="10dp"
        android:src="@drawable/mascot_happy"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💊 MedTrack"
            android:textStyle="bold"
            android:textSize="13sp"
            android:textColor="@color/widget_title" />

        <LinearLayout
            android:id="@+id/widget_dots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <ImageView android:id="@+id/dot1" android:layout_width="16dp" android:layout_height="16dp"
                android:layout_marginEnd="4dp" android:src="@drawable/dot_upcoming" android:importantForAccessibility="no" />
            <ImageView android:id="@+id/dot2" android:layout_width="16dp" android:layout_height="16dp"
                android:layout_marginEnd="4dp" android:src="@drawable/dot_upcoming" android:importantForAccessibility="no" />
            <ImageView android:id="@+id/dot3" android:layout_width="16dp" android:layout_height="16dp"
                android:layout_marginEnd="4dp" android:src="@drawable/dot_upcoming" android:visibility="gone" android:importantForAccessibility="no" />
            <ImageView android:id="@+id/dot4" android:layout_width="16dp" android:layout_height="16dp"
                android:src="@drawable/dot_upcoming" android:visibility="gone" android:importantForAccessibility="no" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="1 / 2 taken ♡"
            android:textSize="12sp"
            android:textColor="@color/widget_text" />
    </LinearLayout>
</LinearLayout>
