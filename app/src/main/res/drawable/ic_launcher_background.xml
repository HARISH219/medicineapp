<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon background: deep midnight-navy vertical gradient (matches the app's dark theme).
  108x108 is the adaptive-icon canvas; the OS masks the outer edges, so the gradient fills it fully.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="108" android:endY="108">
                <item android:offset="0.0" android:color="#FF13224A" />
                <item android:offset="1.0" android:color="#FF0A1330" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
