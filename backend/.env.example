# Copy to .env and fill in. NEVER commit the real .env.
# The Turso token lives ONLY here on the server — never in the Android app.

TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=

# Port the API listens on
PORT=8080

# Firebase Cloud Messaging (optional; enables push to monitor devices).
# Path to your Firebase service-account JSON, or leave blank to disable push.
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# A random string used to sign device session tokens.
SESSION_SIGNING_SECRET=
