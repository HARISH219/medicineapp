# TB MedTrack — example configuration. Copy to .env and fill in for the BACKEND only.
# The Android app never reads a Turso token; it only talks to your backend over HTTPS.

# Backend (see backend/.env.example for the full list)
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=
API_BASE_URL=https://your-backend.example.com
